{
  "name": "overmux-workspace",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format-check && pnpm lint && pnpm check-file-names && pnpm check-runtime-boundaries && pnpm misc-checks && pnpm check-ai-context-docs && pnpm generate-content && pnpm check-unused",
    "check-changesets": "node scripts/check-changesets.ts && node scripts/check-standard-release.ts",
    "check-file-names": "node scripts/check-file-names.ts",
    "check-runtime-boundaries": "node scripts/check-runtime-boundaries.ts",
    "check-unused": "knip",
    "changeset": "changeset",
    "changeset-publish": "node scripts/check-standard-release.ts && changeset publish",
    "changeset-version": "node scripts/check-standard-release.ts && changeset version && pnpm install",
    "local-ci": "pnpm check-changesets && pnpm check && pnpm typecheck && pnpm test && pnpm integration-test && pnpm build",
    "dev": "turbo run dev",
    "deploy-www": "pnpm --filter @overmux/infra deploy",
    "dev-www": "pnpm --filter @overmux/www dev",
    "dev-www-cloudflare": "pnpm --filter @overmux/infra dev-www-cloudflare --stage local",
    "format": "vp fmt '**/*.{js,ts,mts,jsx,tsx,json}' && prettier --write '**/*.{yaml,yml}'",
    "format-check": "vp fmt --check '**/*.{js,ts,mts,jsx,tsx,json}' && prettier --check '**/*.{yaml,yml}'",
    "generate-content": "turbo run generate-content",
    "lint": "vp lint --deny-warnings",
    "lint-fix": "vp lint --fix --deny-warnings",
    "misc-checks": "node scripts/misc-checks.ts",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && vp config --hooks-only || true",
    "setup-local-dot-env": "node scripts/write-local-dot-env.ts",
    "test": "pnpm test:check-changesets && CI=true turbo run test",
    "test:check-changesets": "vitest run scripts/check-changesets.unit.test.ts scripts/check-standard-release.unit.test.ts",
    "test:coverage": "CI=true turbo run test -- --coverage",
    "test:e2e": "pnpm build && pnpm --filter overmux test:e2e",
    "integration-test": "turbo run integration-test",
    "typecheck": "turbo run typecheck",
    "generate-ai-context-docs": "node scripts/generate-ai-context-docs.ts",
    "check-ai-context-docs": "node scripts/generate-ai-context-docs.ts --check"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@changesets/config": "catalog:",
    "@changesets/get-release-plan": "catalog:",
    "@changesets/parse": "catalog:",
    "@changesets/should-skip-package": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@manypkg/get-packages": "catalog:",
    "@overmux/git": "workspace:*",
    "@overmux/pi": "workspace:*",
    "@overmux/tmux": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "knip": "catalog:",
    "overmux": "workspace:*",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}

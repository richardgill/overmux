{
  "name": "@overmux/www",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "WWW_APP_ONLY=true vite build",
    "check-generated-routes": "node scripts/check-generated-routes.ts",
    "dev": "WWW_APP_ONLY=true vite dev",

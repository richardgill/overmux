    "fumadocs-core": "catalog:",
    "fumadocs-ui": "catalog:",
    "lucide-react": "catalog:",
    "posthog-node": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@overmux/tsconfig": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",

{
  "name": "@overmux/lib",
  "version": "0.0.1",
  "private": true,
  "description": "Environment-neutral foundational utilities for Overmux",
  "homepage": "https://github.com/richardgill/overmux/tree/main/packages/runtime/lib",
  "repository": {
    "type": "git",
    "url": "https://github.com/richardgill/overmux",
    "directory": "packages/runtime/lib"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "src",
    "!src/**/*.test.*",
    "!src/**/fixtures",
    "!src/**/testing",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && vp pack",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@overmux/tsconfig": "workspace:*",
    "vitest": "catalog:"
  }
}

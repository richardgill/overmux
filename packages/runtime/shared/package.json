{
  "name": "@overmux/shared",
  "version": "0.0.1",
  "description": "Internal contracts and platform conventions shared by Overmux runtimes",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && vp pack",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jiti": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@overmux/ai-context": "workspace:*",
    "@overmux/lib": "workspace:*",
    "@overmux/tsconfig": "workspace:*",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}

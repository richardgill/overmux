{
  "name": "@overmux/git",
  "version": "0.0.11",
  "license": "MIT",
  "description": "Authorized Git status and diff subscriptions with opt-in mutations for Overmux",
  "homepage": "https://github.com/richardgill/overmux/tree/main/packages/ecosystem/git",
  "repository": {
    "type": "git",
    "url": "https://github.com/richardgill/overmux",
    "directory": "packages/ecosystem/git"
  },
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    }
  },
  "files": [
    "LICENSE",
    "dist",
    "docs",
    "src",
    "!src/**/*.test.*",
    "!src/**/fixtures",
    "!src/**/testing",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && vp pack",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "diff": "9.0.0"
  },
  "devDependencies": {
    "@overmux/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "overmux": "workspace:*",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "overmux": "^0.0.11",
    "zod": "catalog:peers"
  }
}

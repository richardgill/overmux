{
  "name": "@overmux/keybindings",
  "version": "0.0.6",
  "license": "MIT",
  "description": "Shared browser keyboard binding utilities for Overmux",
  "homepage": "https://github.com/richardgill/overmux/tree/main/packages/ecosystem/keybindings",
  "repository": {
    "type": "git",
    "url": "https://github.com/richardgill/overmux",
    "directory": "packages/ecosystem/keybindings"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [

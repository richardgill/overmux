{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@overmux/xterm-fork#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "passThroughEnv": [
        "NODE_OPTIONS",
        "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH",
        "XTERM_RECIPE_WORKDIR"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate-content": {
      "outputs": [".content-collections/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "overmux#test": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "integration-test": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  },
  "globalDependencies": [
    "scripts/generate-ai-context-docs.ts",
    "packages/runtime/ai-context/src/**",
    "packages/runtime/overmux/docs/400-reference/700-cli/600-docs.md"
  ]
}
